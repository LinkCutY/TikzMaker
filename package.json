{
  "name": "tikz-studio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A friendly, mature TikZ editor: live preview, export, and an API surface for image-to-TikZ.",
  "scripts": {
    "dev": "concurrently -n web,api -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:web": "vite",
    "dev:api": "node server/index.mjs",
    "build": "tsc --noEmit && vite build",
    "start": "cross-env NODE_ENV=production node server/index.mjs",
    "preview": "vite preview",
    "test:vectorize": "node scripts/run-ts.mjs scripts/test-vectorize.ts",
    "test:lines": "node scripts/run-ts.mjs scripts/test-lines-doc.ts",
    "test:curves": "node scripts/run-ts.mjs scripts/test-curves.ts",
    "test:primitives": "node scripts/run-ts.mjs scripts/test-primitives.ts",
    "test:snap": "node scripts/run-ts.mjs scripts/test-snaplabels.ts",
    "test:roundtrip": "node scripts/run-ts.mjs scripts/test-figure-roundtrip.ts",
    "test:labels": "node scripts/run-ts.mjs scripts/test-labels.ts",
    "test:verify": "node scripts/run-ts.mjs scripts/test-verify.ts",
    "test:textfit": "node scripts/run-ts.mjs scripts/test-textfit.ts",
    "test:shape": "node scripts/run-ts.mjs scripts/test-shape.ts",
    "test:denoise": "node scripts/test-denoise.mjs",
    "test:residual": "node scripts/test-residual.mjs",
    "test:groundtext": "node scripts/run-ts.mjs scripts/test-groundtext.ts",
    "test:ridge": "node scripts/run-ts.mjs scripts/test-ridge.ts",
    "test:landmarks": "node scripts/test-curve-landmarks.mjs",
    "test:y-axis": "node scripts/run-ts.mjs scripts/test-y-axis.ts",
    "test:relations": "node scripts/test-curve-relations.mjs",
    "test:joint": "node scripts/test-joint-fit.mjs",
    "test:plot-accept": "node scripts/test-plot-acceptance.mjs",
    "shot:vector": "node scripts/shot-vector.mjs",
    "shot:hybrid": "node scripts/shot-hybrid.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.18.4",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/language": "^6.10.8",
    "@codemirror/legacy-modes": "^6.4.2",
    "@codemirror/lint": "^6.8.4",
    "@codemirror/search": "^6.5.9",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.35.0",
    "@lezer/highlight": "^1.2.1",
    "@visioncortex/vtracer": "^1.0.0-alpha.4",
    "clsx": "^2.1.1",
    "esbuild": "^0.25.12",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "puppeteer-core": "^25.16.0",
    "typescript": "^5.7.2",
    "vite": "^6.0.5"
  }
}
